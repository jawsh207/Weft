    <string name="settings_suggestions">Show suggestions</string>
    <string name="settings_suggestions_body">Word suggestions and next-word predictions above the keys.</string>
    <string name="settings_autocorrect">Autocorrect</string>
    <string name="settings_autocorrect_body">Fix typos when you press space. Press delete right after to undo.</string>
    <string name="settings_swipe">Swipe typing</string>
    <string name="settings_swipe_body">Slide across the letters to type a word, lifting between words. Spaces are added for you; delete removes the whole word.</string>
    <string name="settings_learn">Learn from my typing</string>
    <string name="settings_learn_body">Remember new words, the words you use most and which words you type together, so suggestions and swipe fit how you write. Undoing a correction keeps that word as you typed it. Stored only on this device, never in password, incognito, email or web address fields.</string>
    <string name="settings_clear_learned">Clear</string>
