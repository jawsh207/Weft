    <string name="learned_about_words">Words you type that aren\'t in the dictionary. Weft suggests one once you\'ve used it twice, or right away if you picked it from the strip.</string>
    <string name="learned_about_pairs">Words you type one after the other. A pair used twice shows up in next-word predictions.</string>
    <string name="learned_about_kept">Words you kept as typed by undoing an autocorrect. Weft won\'t correct them.</string>
    <string name="learned_about_removed">Words you removed from suggestions with a long-press. Weft won\'t suggest them.</string>
